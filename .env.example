# Copy to .env.local and fill in the values you need.

# ---------- Email delivery ----------
# Required for the contact form to deliver anything.
RESEND_API_KEY=
# Verified sender. Defaults to the Resend onboarding address.
CONTACT_FROM_ADDRESS="Portfolio Contact Form <onboarding@resend.dev>"

# ---------- Contact form abuse protection ----------
# Signs the session cookie and the single-use submit tickets. Falls back to
# RESEND_API_KEY when unset; set an explicit value in production so rotating
# the Resend key does not invalidate every open form.
CONTACT_SECRET=

# Cloudflare Turnstile. Verification is enforced only when BOTH keys are set,
# so the form keeps working before the keys exist.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Durable rate-limit counters over the Upstash/Vercel KV REST API. Strongly
# recommended in production: without them counters live in the memory of a
# single serverless instance and reset on cold starts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL / KV_REST_API_TOKEN are also accepted.

# Optional webhook (Slack-compatible JSON) for blocked-IP and delivery-failure
# alerts. Alerts are coalesced to at most one per reason every 10 minutes.
CONTACT_ALERT_WEBHOOK_URL=

# Quota overrides. Defaults shown; see lib/security/config.ts for the rest.
CONTACT_MAX_PER_IP_HOUR=5
CONTACT_MAX_PER_IP_DAY=10
CONTACT_MAX_GLOBAL_HOUR=30
CONTACT_MAX_GLOBAL_DAY=120
CONTACT_MAX_STRIKES=10
CONTACT_MIN_FILL_MS=3000

# Extra origin allowed to post to /api/contact (e.g. a custom domain).
CONTACT_ALLOWED_ORIGIN=
