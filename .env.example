# EmailJS (contact form) — see README.md "Contact form email configuration"
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Cloudflare Turnstile (contact form bot protection) — see README.md
# "Contact form bot protection". Optional: the form falls back to
# honeypot-only protection when these are unset.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
